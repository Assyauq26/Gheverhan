# Copy to .env on the VPS. Never commit the populated file.
# Use hexadecimal password/secret values to avoid URL and Compose interpolation.
POSTGRES_PASSWORD=
# Generated privately by prepare-runtime.py after Prisma migrations.
APP_DATABASE_PASSWORD=
JWT_SECRET=
CRON_SECRET=
RESEND_API_KEY=
PASSWORD_RESET_FROM=Gheverhan <noreply@gheverhan.store>
PASSWORD_RESET_BASE_URL=https://gheverhan.store
STORAGE_APP_NAME=gheverhan
MAINTENANCE_MODE=1
GHEVERHAN_IMAGE=
# Do not set VERCEL_ENV or Supabase certificate variables for local PostgreSQL.

APP_ORIGIN=https://gheverhan.store
# V5: absent approved tariffs intentionally disable new order submission.
# Populate only with approved operator configuration; no example/dummy rates.
REGION_DATA_MODE=
SHIPPING_PROVIDER=manual
JNT_MANUAL_RATE_CONFIG=
JNT_OFFICIAL_AREA_MAPPING=
JNT_ORIGIN_WAREHOUSE=
# Warehouse for Create Order (never dummy customer data)
JNT_ORIGIN_CITY_CODE=
JNT_SENDER_NAME=
JNT_SENDER_CONTACT=
JNT_SENDER_PHONE=
JNT_SENDER_ADDRESS=
# Never enable until J&T approval and test/rollback gates are complete.
JNT_ENABLE_ORDER_CREATE=no
JNT_ENABLE_CANCELLATION=no
JNT_PRODUCTION_ORDER_APPROVED=no
JNT_PRODUCTION_API_APPROVED=no
# J&T official integration is disabled until explicitly configured and approved.
# Generate a random 32-byte Base64 key securely, keep it off Git.
JNT_API_ENV=
JNT_RATE_SERVICES=
JNT_PLATFORM_OWNER_USER_IDS=
JNT_INTEGRATION_ENCRYPTION_KEY=
