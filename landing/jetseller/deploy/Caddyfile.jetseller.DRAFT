# DRAFT ONLY -- do not apply without separate deployment approval.
# This is a complete candidate Caddyfile for review, not a command to run.
# Confirm the /data mount Source again immediately before deployment.

www.gheverhan.store {
  redir https://gheverhan.store{uri} permanent
}

gheverhan.store {
  encode zstd gzip
  reverse_proxy app:3000
}

# Stage new domain and HTTPS first; DO NOT activate this full draft until
# public DNS, certificate issuance, and the old-domain compatibility plan pass.
www.buattokosendiri.web.id {
  redir https://buattokosendiri.web.id{uri} permanent
}

buattokosendiri.web.id {
  encode zstd gzip
  root * /data/landing/jetseller

  # Asset names are not content-hashed yet: cache briefly and revalidate.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=3600, must-revalidate"

  # HTML must always revalidate so status/copy updates become visible quickly.
  @html path / /index.html /daftar/ /daftar/index.html /masuk/ /masuk/index.html /404.html
  header @html Cache-Control "no-cache"

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    -Server
  }

  file_server

  handle_errors {
    rewrite * /404.html
    file_server
  }
}

# LEGACY CUTOVER (enable only after the new landing and all former portal
# URL consumers have been verified; preserve the old domain's active TLS).
www.jetseller.web.id {
  redir https://buattokosendiri.web.id{uri} permanent
}

jetseller.web.id {
  redir https://buattokosendiri.web.id{uri} permanent
}

# No wildcard routing. This static landing DOES NOT host the seller portal.
# dashboard.buattokosendiri.web.id must receive a SEPARATELY REVIEWED HTTPS
# reverse_proxy to the isolated installer-control service after OIDC readiness.
# Seller storefronts always use their own domains, never platform subdomains.
# Preserve the separate staging host on its dedicated VPS.
# Gheverhan production app/router must remain unchanged.
