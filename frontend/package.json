{
  "name": "gheverhan",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:preview": "next dev -H 0.0.0.0 -p 3000",
    "start": "npm run dev",
    "build": "prisma generate && next build",
    "serve": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/assert-safe-db-operation.mjs && prisma migrate dev",
    "prisma:deploy": "node scripts/assert-safe-db-operation.mjs && prisma migrate deploy",
    "prisma:bootstrap-admin": "node scripts/assert-safe-db-operation.mjs && tsx prisma/bootstrap-admin.ts",
    "seed": "node scripts/assert-safe-db-operation.mjs && tsx prisma/seed.ts",
    "test": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs watch",
    "e2e": "playwright test",
    "test:containment": "node --test tests/security/containment.test.mjs",
    "test:ci": "npm run test:containment && npm test",
    "test:integration:products": "node --disable-proto=throw --import tsx --test tests/integration/product-lifecycle.test.ts",
    "test:e2e:products": "node --import tsx tests/integration/product-browser.ts",
    "test:integration:transactions": "node --disable-proto=throw --import tsx --test tests/integration/transaction-correctness.test.ts",
    "test:integration:refund-shipping": "node --disable-proto=throw --import tsx --test tests/integration/order-refund-shipping.test.ts",
    "test:e2e:operations": "node --import tsx tests/integration/operations-browser.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.1",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "lucide-react": "0.454.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "prisma": "5.22.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
