# JetSeller Self-Hosted M1-01: SCHEMA ONLY, NOT A RUNNABLE INSTALLER.
# For disposable isolated fixtures only; an approved installer must generate these values.
# Do not commit populated secrets or use this profile on gheverhan.store.

JETSELLER_STORE_PROFILE=self-hosted
JETSELLER_INSTALLATION_MODE=new
JETSELLER_INSTALLATION_ID=
JETSELLER_STORE_DOMAIN=
APP_ORIGIN=

# Local-only media: the target path must be a durable private mount.
STORAGE_PROVIDER=local
STORAGE_APP_NAME=
STORAGE_LOCAL_ROOT=

# Installer provisions a unique database and distinct runtime/migration roles.
# Both point to the *local* Docker Compose PostgreSQL service "db" or "postgres".
# DATABASE_URL=postgresql://<runtime-role>:<secret>@db:5432/<js_uuidhex>?schema=public
# DIRECT_URL=postgresql://<migration-role>:<different-secret>@db:5432/<js_uuidhex>?schema=public
DATABASE_URL=
DIRECT_URL=

# Generate a unique random 32-byte hexadecimal signing key per installation.
# IMPORTANT: Do not copy a fixture/production JWT_SECRET into another installation.
JWT_SECRET=
AUTH_COOKIE_NAME=

# Sender identity and reset URL must match the store's verified domain.
PASSWORD_RESET_FROM=
PASSWORD_RESET_BASE_URL=

# Seller-owned J&T integration is NOT enabled by the initial installer.
JNT_ENABLE_ORDER_CREATE=no
JNT_PRODUCTION_ORDER_APPROVED=no
JNT_PRODUCTION_API_APPROVED=no

# All absent/blank keys remain unusable until the wizard securely provisions them.
# No central SSH, Supabase service-role credentials or shared PAT.
